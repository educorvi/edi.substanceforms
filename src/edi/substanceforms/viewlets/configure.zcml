<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="edi.substanceforms">

  -*- extra stuff goes here -*-

  <browser:viewlet
     name="substance-tabelle-viewlet"
     for="plone.app.contenttypes.interfaces.IDocument"
     manager="plone.app.layout.viewlets.interfaces.IAboveContentTitle"
     layer="edi.substanceforms.interfaces.IEdiSubstanceformsLayer"
     class=".substance_tabelle_viewlet.SubstanceTabelleViewlet"
     template="substance-tabelle-viewlet.pt"
     permission="zope2.View"
     />

</configure>
